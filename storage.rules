rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Logos de empresas: públicos para visualización en pantallas de inicio/login
    match /logos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Comprobantes fiscales y recibos: protegidos estrictamente para usuarios autenticados
    match /receipts/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // Comprobantes de recarga de fondos: protegidos para usuarios autenticados
    match /recharges/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // Regla de cierre por defecto
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
