rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Permite lectura de archivos
    match /{allPaths=**} {
      allow read: if true;
    }

    // Permite a usuarios autenticados subir logos
    match /logos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Permite a usuarios autenticados subir comprobantes
    match /receipts/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /recharges/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
