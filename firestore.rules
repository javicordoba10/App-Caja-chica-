rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSuperAdmin() {
      return request.auth != null && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'superadmin';
    }
    
    function isAdminOf(companyId) {
      return request.auth != null && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin' &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('companyId', '') == companyId;
    }

    // Users collection
    match /users/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId || 
        isSuperAdmin() ||
        (resource != null && isAdminOf(resource.data.companyId))
      );
      
      // Creación de usuario (registro): no permite auto-asignarse superadmin
      allow create: if request.auth != null && (
        (request.auth.uid == userId && request.resource.data.get('role', 'user') != 'superadmin') ||
        isSuperAdmin() ||
        isAdminOf(request.resource.data.companyId)
      );
      
      // Actualización de usuario: usuarios comunes no pueden auto-escalarse a superadmin ni cambiarse de empresa
      allow update: if request.auth != null && (
        isSuperAdmin() ||
        (resource != null && isAdminOf(resource.data.companyId)) ||
        (request.auth.uid == userId && 
         request.resource.data.get('role', '') == resource.data.get('role', '') &&
         request.resource.data.get('companyId', '') == resource.data.get('companyId', ''))
      );
      
      // Eliminación (Derecho al olvido / baja de cuenta)
      allow delete: if request.auth != null && (
        request.auth.uid == userId ||
        isSuperAdmin() ||
        (resource != null && isAdminOf(resource.data.companyId))
      );
    }
    
    // Movements collection
    match /movements/{movementId} {
      allow read, write: if request.auth != null && (
        (resource == null && request.resource.data.userId == request.auth.uid) || 
        (resource != null && resource.data.userId == request.auth.uid) ||
        isSuperAdmin() ||
        (resource != null && isAdminOf(resource.data.companyId)) ||
        (resource == null && isAdminOf(request.resource.data.companyId))
      );
    }

    // Recharge requests collection
    match /recharge_requests/{requestId} {
      allow read: if request.auth != null && (
        (resource != null && resource.data.userId == request.auth.uid) ||
        isSuperAdmin() ||
        (resource != null && isAdminOf(resource.data.companyId))
      );
      allow write: if request.auth != null && (
        (resource == null && request.resource.data.userId == request.auth.uid) || 
        (resource != null && resource.data.userId == request.auth.uid) ||
        isSuperAdmin() ||
        (resource != null && isAdminOf(resource.data.companyId)) ||
        (resource == null && isAdminOf(request.resource.data.companyId))
      );
    }

    // Company Config - Lectura pública para login/onboarding, escritura segura
    match /companies_config/{companyId} {
      allow read: if true;
      allow write: if request.auth != null && (
        isSuperAdmin() || 
        isAdminOf(companyId) ||
        !exists(/databases/$(database)/documents/companies_config/$(companyId))
      );
    }
  }
}
