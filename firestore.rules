rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users collection: lectura y escritura para usuarios autenticados
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }
    
    // Movements collection: lectura y escritura para usuarios autenticados
    match /movements/{movementId} {
      allow read, write: if request.auth != null;
    }

    // Recharge requests collection: lectura y escritura para usuarios autenticados
    match /recharge_requests/{requestId} {
      allow read, write: if request.auth != null;
    }

    // Company Config: lectura pública para login/onboarding y branding, escritura autenticada
    match /companies_config/{companyId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
